# OCI Database Observatory - Environment Configuration
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control

# =============================================================================
# Core Settings
# =============================================================================
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# =============================================================================
# OCI Configuration
# =============================================================================
# Path to OCI config file (default: ~/.oci/config)
OCI_CONFIG_FILE=~/.oci/config

# OCI CLI profile to use (must exist in config file)
OCI_CLI_PROFILE=DEFAULT

# OCI Compartment for resources
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment-id

# OCI Region
OCI_REGION=us-ashburn-1

# =============================================================================
# OCI APM / OpenTelemetry
# =============================================================================
# APM Domain endpoint (from OCI APM Domain details)
OCI_APM_ENDPOINT=https://your-apm-domain.apm-agt.us-ashburn-1.oci.oraclecloud.com

# APM Private Data Key (for server-side tracing)
OCI_APM_PRIVATE_DATA_KEY=your-private-data-key

# APM Public Data Key (for client-side tracing)
OCI_APM_PUBLIC_DATA_KEY=your-public-data-key

# APM Domain ID (for console links)
OCI_APM_DOMAIN_ID=ocid1.apmdomain.oc1..your-domain-id

# Enable/disable tracing
OTEL_TRACING_ENABLED=true

# Service name for this application (unique per component)
OTEL_SERVICE_NAME=oci-obs-api

# =============================================================================
# OCI Logging
# =============================================================================
# Enable OCI Logging integration
OCI_LOGGING_ENABLED=true

# Log group and log names (will be auto-created if not exist)
OCI_LOG_GROUP_NAME=oci-database-observatory
OCI_LOG_NAME=application-logs

# =============================================================================
# Oracle Code Assist (OCA)
# =============================================================================
# IDCS URL for OAuth authentication
OCA_IDCS_URL=https://idcs-your-instance.identity.oraclecloud.com

# OAuth Client ID
OCA_CLIENT_ID=your-oca-client-id

# OAuth Redirect URI
OCA_REDIRECT_URI=http://localhost:3001/api/oca/callback

# OCA API Base URL
OCA_API_URL=https://your-oca-endpoint.oraclecloud.com

# Default OCA model
OCA_DEFAULT_MODEL=oci.generativeai.cohere.command-r-plus

# Callback server settings
OCA_CALLBACK_HOST=127.0.0.1
OCA_CALLBACK_PORT=48801

# =============================================================================
# LLM Providers
# =============================================================================
# Default LLM provider (oracle_code_assist, anthropic, openai, gemini)
LLM_PROVIDER=oracle_code_assist

# Default model
LLM_MODEL=claude-sonnet-4-20250514

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI API Key
OPENAI_API_KEY=sk-your-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key

# =============================================================================
# MCP Servers
# =============================================================================
# OCI Operations Insights MCP Server
OPSI_HTTP_URL=http://localhost:8000/mcp

# OCI Logging Analytics MCP Server
LOGAN_HTTP_URL=http://localhost:8001/mcp

# OCI Unified MCP Server (compute, network, cost, etc.)
OCI_MCP_HTTP_URL=http://localhost:8002/mcp

# MySQL MCP Server
MYSQL_MCP_URL=http://localhost:8003/mcp

# PostgreSQL MCP Server
POSTGRES_MCP_URL=http://localhost:8004/mcp

# Oracle SQLcl path
SQLCL_PATH=/Applications/sqlcl/bin/sql

# =============================================================================
# Caching
# =============================================================================
# Redis URL for caching
REDIS_URL=redis://localhost:6379

# =============================================================================
# Session
# =============================================================================
# Session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change-this-to-a-random-32-byte-hex-string

# Enable secure cookies (set true in production with HTTPS)
SESSION_SECURE=false

# =============================================================================
# Slack Integration (Optional)
# =============================================================================
# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=

# Slack App Token (xapp-...)
SLACK_APP_TOKEN=

# Slack Signing Secret
SLACK_SIGNING_SECRET=
